# Copy this file to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is git-ignored. NEVER commit real keys.

# Safe in the browser (respects Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# SERVER ONLY — bypasses RLS. Never prefix NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build magic-link redirect URLs. Local: http://localhost:3000
# Production: your deployed URL, e.g. https://portal.psyberdigital.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build billing (Stripe). SERVER ONLY except the publishable key.
# Test mode uses sk_test_/pk_test_ keys; live keys only at go-live (move m14).
STRIPE_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Signing secret of the webhook endpoint /api/stripe/webhook (Stripe → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret
# The billing page settings members see (Stripe → Settings → Customer portal, or the API).
STRIPE_PORTAL_CONFIGURATION_ID=bpc_your-configuration-id
